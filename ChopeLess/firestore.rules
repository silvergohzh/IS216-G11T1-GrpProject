rules_version = '2';

// Who can read and write what. The browser talks to Firestore directly,
// so THESE RULES are our security. The Express server skips them (it is trusted).
// Owners: each block is owned by the member who owns that collection.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- users (M6) ----------
    // You can only see and change your own profile.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- places (M5 seeds, M4 analyses) ----------
    // Everyone can read. Only the server (seed script, photo analysis route) writes.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
      match /analyses/{analysisId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---------- gems (M5) ----------
    match /gems/{gemId} {
      allow read: if true;

      // You can add a gem as yourself, starting with no upvotes
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.upvoters.size() == 0;

      allow update: if signedIn() && (
        // The person who submitted it can edit the details
        (resource.data.submittedBy == request.auth.uid
          && changedOnly(['name', 'mustTry', 'price', 'address', 'lat', 'lng', 'dietary']))
        ||
        // Anyone else can add exactly one upvote: their own
        (changedOnly(['upvoters'])
          && !(request.auth.uid in resource.data.upvoters)
          && request.resource.data.upvoters.size() == resource.data.upvoters.size() + 1
          && request.auth.uid in request.resource.data.upvoters)
      );

      allow delete: if signedIn() && resource.data.submittedBy == request.auth.uid;
    }

    // ---------- sessions (M1) ----------
    // Document id = the 6-letter join code.
    match /sessions/{code} {
      allow read: if signedIn();

      // Host creates the session in the lobby, as the only member
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      // While in the lobby: the host can change settings, and anyone can add or edit THEIR OWN member entry.
      // Starting the vote, voting and the winner are done by the server, never the browser.
      allow update: if signedIn() && resource.data.status == 'lobby' && (
        (resource.data.hostUid == request.auth.uid
          && changedOnly(['meetingPoint', 'serviceMode', 'maxWalkMins', 'maxWaitMins']))
        ||
        (changedOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
