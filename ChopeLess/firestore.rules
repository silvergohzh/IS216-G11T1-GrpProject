
rules_version = '2';

// Who can read and write what. The browser talks to Firestore directly,
// so THESE RULES are our security. The Express server skips them (it is trusted).
// Owners: each block is owned by the member who owns that collection.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(fields);
    }

    // M1: Validate a member's preferences
    function validMember(member) {
      return member is map
        && member.keys().hasOnly(['name', 'budget', 'dietary'])
        && member.keys().hasAll(['name', 'budget', 'dietary'])
        && member.name is string
        && member.name.size() > 0
        && member.name.size() <= 50
        && member.budget is number
        && member.budget >= 0
        && member.budget <= 1000
        && member.dietary is list
        && member.dietary.size() <= 10;
    }

     // ---------- users (M6) ----------
    // You can only see and change your own profile.
    match /users/{uid} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    // Meal history: you read and delete your own; only the server writes it (M3)
    match /users/{uid}/history/{code} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Saved places (♥): you read and change only your own (M3)
    match /users/{uid}/saved/{placeId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- places (M5 seeds, M4 analyses) ----------
    // Everyone can read. Only the server (seed script, photo analysis route) writes.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;

      match /analyses/{analysisId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---------- gems (M5) ----------
    match /gems/{gemId} {
      allow read: if true;

      // You can add a gem as yourself, starting with no upvotes
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.upvoters.size() == 0;

      allow update: if signedIn() && (
        // The person who submitted it can edit the details
        (resource.data.submittedBy == request.auth.uid
          && changedOnly([
            'name',
            'mustTry',
            'price',
            'address',
            'lat',
            'lng',
            'dietary'
          ]))
        ||
        // Anyone else can add exactly one upvote: their own
        (changedOnly(['upvoters'])
          && !(request.auth.uid in resource.data.upvoters)
          && request.resource.data.upvoters.size()
            == resource.data.upvoters.size() + 1
          && request.auth.uid in request.resource.data.upvoters)
      );

      allow delete: if signedIn()
        && resource.data.submittedBy == request.auth.uid;
    }

    // ---------- groups (M3: Makan Kakis) ----------
    match /groups/{code} {
      allow read: if signedIn();

      // You create a group with yourself as the owner and only member
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // The owner can rename, remove members and set the live session
        (resource.data.ownerUid == request.auth.uid
          && changedOnly(['name', 'memberUids', 'members', 'activeSession']))
        ||
        // Any member can start a session for the group
        (request.auth.uid in resource.data.memberUids
          && changedOnly(['activeSession']))
        ||
        // Anyone can add or remove ONLY themselves (join / leave)
        (changedOnly(['memberUids', 'members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet())
               .union(resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()))
               .hasOnly([request.auth.uid]))
      );

      // Only the owner can delete the group
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- sessions (M1) ----------
    // Document ID = the 6-letter join code.
    match /sessions/{code} {

      // Signed-in users can read sessions
      allow read: if signedIn();

      // CREATE: Only the host can create a session
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.code == code
        && code.matches('[A-Z]{6}')
        && request.resource.data.members is map
        && request.resource.data.members.keys()
          .hasOnly([request.auth.uid])
        && request.resource.data.members.keys()
          .hasAll([request.auth.uid])
        && validMember(
          request.resource.data.members[request.auth.uid]
        )
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      // UPDATE: Only while the lobby is active and not expired
      allow update: if signedIn()
        && resource.data.status == 'lobby'
        && resource.data.expiresAt > request.time
        && (

          // Host can change session settings
          (
            resource.data.hostUid == request.auth.uid
            && changedOnly([
              'meetingPoint',
              'serviceMode',
              'maxWalkMins',
              'maxWaitMins',
              'voteSeconds'
            ])
          )

          ||

          // Members can join, update or leave
          (
            changedOnly(['members'])

            // Only your own member entry can change
            && request.resource.data.members
              .diff(resource.data.members)
              .affectedKeys()
              .hasOnly([request.auth.uid])

            // Host cannot remove themselves
            && (
              request.auth.uid != resource.data.hostUid
              || request.auth.uid
                in request.resource.data.members
            )

            // Validate preferences if the member entry exists
            && (
              !(request.auth.uid
                in request.resource.data.members)
              || validMember(
                request.resource.data.members[request.auth.uid]
              )
            )
          )
        );

      
      // DELETE: Only the host can delete the session
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;
    }

    // ---------- Makan Points ----------
    // Points are managed by the trusted Express backend.
    // Users cannot directly change balances or ledger entries.

    match /pointsAccounts/{uid} {
      allow read, write: if false;
    }

    match /pointsLedger/{entryId} {
      allow read, write: if false;
    }

    // ---------- Crowd report verification ----------
// Trusted backend manages reports and verification results.
match /crowdReports/{reportId} {
  allow read, write: if false;
}

match /crowdReportCooldowns/{uid}/places/{placeId} {
  allow read, write: if false;
}

  }
}

