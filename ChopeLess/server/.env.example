# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000
CLIENT_URL=http://localhost:5173
FIREBASE_PROJECT_ID=demo-hiddengems

# --- Local development with the Firebase emulators (default) ---
# These two lines make the server talk to the emulators instead of the real Firebase.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Real Firebase project (for deployment) ---
# Delete the two EMULATOR lines above, set FIREBASE_PROJECT_ID to the real project id,
# and paste the service account key JSON (Project settings > Service accounts) on ONE line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# OpenAI (M4). Leave blank and QueueLess returns sample estimates.
OPENAI_API_KEY=

# Stripe, TEST MODE only (M6). Leave blank and orders are marked paid straight away (demo mode).
# Get the key from dashboard.stripe.com > Developers > API keys (it starts with sk_test_).
STRIPE_SECRET_KEY=
# The webhook secret (starts with whsec_). Locally: run `stripe listen --forward-to localhost:3000/api/payments/webhook`
# and copy the secret it prints. On Render: create a webhook in the Stripe dashboard pointing to
# https://<render-url>/api/payments/webhook (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
